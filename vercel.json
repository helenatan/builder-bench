{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noai, noimageai"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/projects/builder-bench/index.html"
    },
    {
      "source": "/tasks/:id",
      "destination": "/projects/builder-bench/tasks/:id.html"
    }
  ]
}
