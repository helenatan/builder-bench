{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noai, noimageai"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://helenatan.ai/projects/builder-bench",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "https://helenatan.ai/projects/builder-bench",
      "permanent": true
    },
    {
      "source": "/tasks/:id",
      "destination": "https://helenatan.ai/projects/builder-bench/tasks/:id",
      "permanent": true
    }
  ]
}
